.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Application data & generated artifacts
# ---------------------------------------------------------------------------
# Generated feature sets, batch outputs, uploaded CSV results
data/processed/
data/outputs/
*.log
logs/
/tmp/

# NOTE: models/trained/*.joblib and *.json are intentionally committed — the API
# loads them at startup so the app runs without retraining first. Only ignore
# temporary/backup model files.
models/trained/*.bak
models/trained/*.tmp

# Guard against a stray nested artifact dir created by running a script from src/
# (train/calibrate scripts now anchor MODEL_DIR to the project root)
src/models/models/

# ---------------------------------------------------------------------------
# OS / editor files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
